# Kopiere diese Datei nach .env. Die Startdateien (start/) machen das beim ersten Start selbst.

# Pflicht: ein langer Zufallswert. Erzeugen: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Port auf deinem Rechner (http://localhost:8080)
AKTE_PORT=8080
# Titel im Browser
AKTE_TITEL=Die Akte

# Lesen ohne Konto (öffentliche Boards). Leer = aus.
AKTE_OEFFENTLICH_AKTIV=
# Boards, die jedes angemeldete Konto lesen darf (kommagetrennte Slugs). Leer = aus.
AKTE_MITGLIEDER_BOARDS=
# Was Leser sehen: nur_gepruefte (Standard: nur, was ein Mensch unterschrieben hat und die Prüfung besteht)
# oder alles_belegte (auch Entwürfe; nur für geschlossene Runden).
# AKTE_LESEANSICHT=nur_gepruefte
# Prüfregeln für alle Boards, z. B. {"quelle_ohne_archiv": "sperrt"}; je Board in der Oberfläche unter „Regeln“.
# AKTE_REGELN=

# Nur, wenn die Akte über HTTPS erreichbar ist (eigener Server): Cookies nur verschlüsselt senden.
# COOKIE_SECURE=true

# Beweissicherung: Standard ist ein Ordner im Daten-Volume. Für einen S3-kompatiblen Speicher (privat!):
# AKTE_S3_BUCKET=
# AKTE_S3_ENDPOINT_URL=
# AKTE_S3_ACCESS_KEY_ID=
# AKTE_S3_SECRET_ACCESS_KEY=

# archive.org bekommt die Adresse jeder Quelle (öffentlich!). Aus = nur die eigene Kopie.
# AKTE_ARCHIV_AKTIV=false
# Optional: archive.org-Schlüssel "zugang:geheim" (sonst drosselt archive.org anonyme Anfragen)
# AKTE_ARCHIVE_ORG_SCHLUESSEL=

# Kennung beim Abruf fremder Seiten; bitte mit einer Kontaktadresse deiner Instanz.
# AKTE_ABRUF_KENNUNG=Die-Akte/0.1 (+https://example.org/kontakt)
