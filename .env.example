# Einstellungen deiner Akte. Der Starter (start\START-AKTE.cmd bzw. start/akte.sh) kopiert diese Datei beim ersten
# Start nach .env und füllt die Pflichtwerte selbst aus. Von Hand: kopieren und die zwei Werte unten setzen.
# .env enthält Geheimnisse: nie weitergeben, nie ins Repo.

# Pflicht: ein langer Zufallswert. Der Starter erzeugt ihn. Von Hand: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Einrichtungscode für das erste Konto. Der Starter erzeugt ihn beim allerersten Start (8 Zeichen wie ABCD-2345)
# und öffnet damit selbst den Browser auf http://localhost:8080/akte/einrichten; dort ist er schon eingetragen.
# Keine Konsole zeigt ihn an. Steht das erste Konto, löscht der Starter den Code hier wieder (die laufende Akte kennt
# ihn, bis sie neu erstellt wird). Eine Akte, die schon Daten hat, bekommt keinen neuen.
# Leer = Einrichtung im Browser aus; dann nur über (ohne Code): docker compose exec api python manage.py akte_einrichten
AKTE_EINRICHTUNGSCODE=

# Port auf deinem Rechner (http://localhost:8080). Ist er belegt, nimmt der Starter den nächsten freien.
AKTE_PORT=8080
# Namen, unter denen die Akte antwortet (durch Leerzeichen getrennt). Andere Namen bekommen die Antwort 421; das
# schützt vor fremden Webseiten, die sich per DNS-Trick als 127.0.0.1 ausgeben. Nur für eine eigene Domain ändern.
# AKTE_HOSTS="localhost 127.0.0.1 ::1 [::1]"
# Dieselben Namen braucht Django, durch Komma getrennt ("api" kommt immer dazu), und die Adressen, von denen aus
# man sich anmeldet. Nur ändern, wenn die Akte unter einer Domain, IP-Adresse oder einem Rechnernamen läuft:
# DJANGO_ALLOWED_HOSTS=akte.example.org,localhost,127.0.0.1,[::1]
# DJANGO_CSRF_TRUSTED_ORIGINS=https://akte.example.org,http://localhost:8080,http://127.0.0.1:8080
# Titel im Browser
AKTE_TITEL=Ultra-Akte

# archive.org: Soll die Akte jede Quelle zusätzlich öffentlich bei archive.org sichern? Dann steht die Adresse
# jeder Quelle dort für alle sichtbar, und archive.org ruft sie selbst ab. Standard: aus (nur die eigene Kopie auf
# deinem Rechner). Beim ersten Konto fragt die Akte im Browser danach; später änderst du es unter „Regeln“ →
# „Für die ganze Akte“. Diese Zeile gilt nur, solange dort nichts gewählt ist.
AKTE_ARCHIV_AKTIV=false
# Optional: archive.org-Schlüssel "zugang:geheim" (sonst drosselt archive.org anonyme Anfragen)
# AKTE_ARCHIVE_ORG_SCHLUESSEL=

# Lesen ohne Konto (öffentliche Boards). Leer = aus.
AKTE_OEFFENTLICH_AKTIV=
# Boards, die jedes angemeldete Konto lesen darf (kommagetrennte Kurznamen aus der Adresse, z. B. demo-musterhafen).
# Leer = aus.
AKTE_MITGLIEDER_BOARDS=
# Was Leser sehen: nur_gepruefte (Standard: nur, was ein Mensch unterschrieben hat und die Prüfung besteht)
# oder alles_belegte (auch Entwürfe; nur für geschlossene Runden).
# AKTE_LESEANSICHT=nur_gepruefte
# Prüfregeln für alle Boards, z. B. {"quelle_ohne_archiv": "sperrt"}; je Board in der Oberfläche unter „Regeln“.
# AKTE_REGELN=

# Nur, wenn die Akte über HTTPS erreichbar ist (eigener Server): Cookies nur verschlüsselt senden.
# COOKIE_SECURE=true

# Beweissicherung: Standard ist ein Ordner im Daten-Volume. Für einen S3-kompatiblen Speicher (privat!):
# AKTE_S3_BUCKET=
# AKTE_S3_ENDPOINT_URL=
# AKTE_S3_ACCESS_KEY_ID=
# AKTE_S3_SECRET_ACCESS_KEY=

# Kennung beim Abruf fremder Seiten. Sie geht an jede Quelle, die die Akte abruft. Auf dem eigenen Rechner leer
# lassen. Nur für eine Akte, die im Netz für andere läuft: mit einer Kontaktadresse dieser Instanz.
# AKTE_ABRUF_KENNUNG=Die-Akte/0.2 (+https://example.org/kontakt)
