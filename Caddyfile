# Ein Eingang für Oberfläche und API (gleiche Herkunft): http://localhost:8080
:8080 {
	encode gzip

	# Sicherheitsköpfe für alles, was dieser Eingang ausliefert. „?“ = nur setzen, wenn die Antwort keinen eigenen
	# trägt (Beweis-Dateien kommen mit einer strengeren CSP aus Django, die bleibt).
	header {
		?X-Content-Type-Options nosniff
		?Referrer-Policy same-origin
		?X-Frame-Options DENY
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		?Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Nur bekannte Adressen (Host-Kopf). Schützt vor DNS-Rebinding: Eine fremde Webseite, deren Name plötzlich auf
	# 127.0.0.1 zeigt, kommt nicht an die Akte. Erlaubt sind die Namen in AKTE_HOSTS (.env, durch Leerzeichen
	# getrennt; compose.yaml reicht sie durch). Wer die Akte unter eigener Domain betreibt, trägt sie dort ein.
	@fremd not host {$AKTE_HOSTS:localhost 127.0.0.1 ::1 [::1]}
	handle @fremd {
		respond "Diese Adresse ist für die Akte nicht freigegeben. Erlaubte Namen stehen in .env unter AKTE_HOSTS." 421
	}

	handle {
		# Die Django-Verwaltung (/admin) ist bewusst nicht erreichbar. Wer sie braucht:
		# docker compose exec api python manage.py … oder eine eigene, nur lokale Route.
		@backend path /api/v1/* /static/*
		handle @backend {
			# API und Verwaltungs-Dateien: eigene, strenge Richtlinie (nur eigene Dateien, keine Rahmen). Die
			# Beweis-Dateien bringen ihre noch strengere CSP selbst mit (sandbox), deshalb auch hier nur setzen, wo
			# keine da ist.
			header {
				?Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
				?Permissions-Policy "camera=(), microphone=(), geolocation=()"
				defer
			}
			reverse_proxy api:8000
		}

		handle {
			reverse_proxy web:3000
		}
	}
}
